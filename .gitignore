# =============================================================================
# MultiTarget BioPredict — .gitignore (Python + Ciência de Dados)
# =============================================================================

# --- Ambientes virtuais ------------------------------------------------------
venv/
.venv/
.venv-*/
env/
.env/
conda/
.conda/

# --- Variáveis de ambiente / segredos ---------------------------------------
.env
*.env
.streamlit/secrets.toml

# --- Caches do Python --------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- IDEs / editores ---------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# --- Sistema operacional -----------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs e temporários ------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/

# =============================================================================
# Dados (data/)
# CSVs essenciais e leves (ex.: datasets curados) PODEM ser versionados.
# Ignoramos apenas temporários, backups, caches e formatos binários pesados.
# =============================================================================
data/**/*.bak
data/**/*.backup
data/**/*.old
data/**/~*
data/**/*.zip
data/**/*.gz
data/**/*.tar
data/**/*.7z
data/**/*.rar
data/**/*.h5
data/**/*.hdf5
data/**/*.pkl
data/**/*.pickle
data/**/*.feather
data/**/*.npy
data/**/*.npz
data/**/cache/
data/**/_tmp*/
# Garante que os marcadores de diretório sempre sejam versionados
!data/**/.gitkeep

# =============================================================================
# Modelos (models/)
# Artefatos finais .joblib (compactados) SÃO versionados.
# Ignoramos checkpoints intermediários e experimentos descartáveis.
# =============================================================================
models/**/checkpoints/
models/**/*_tmp.*
models/**/*.bak
!models/.gitkeep

# --- Caches de bibliotecas ---------------------------------------------------
catboost_info/
.cache/
